{
  "color": {
    "ink": {
      "$type": "color",
      "$value": "#1E2B3A",
      "$description": "Encre. Tout le texte, y compris sur les fonds pastel. Icônes."
    },
    "oly-blue": {
      "$type": "color",
      "$value": "#006FD6",
      "$description": "Bleu OLY. Titres de 24 px et plus uniquement (h2 de section)."
    },
    "link": {
      "$type": "color",
      "$value": "#0A5CB0",
      "$description": "Bleu lien. Liens, bouton secondaire, onglet actif, contour de focus."
    },
    "link-hover": {
      "$type": "color",
      "$value": "#08498C",
      "$description": "Bleu lien survol. Survol des liens et du bouton secondaire."
    },
    "coral": {
      "$type": "color",
      "$value": "#D93A39",
      "$description": "Corail bouton. Fond du bouton principal (texte blanc). Un seul par écran si possible."
    },
    "coral-hover": {
      "$type": "color",
      "$value": "#B92F2E",
      "$description": "Corail survol. Survol du bouton principal."
    },
    "teal": {
      "$type": "color",
      "$value": "#015C73",
      "$description": "Canard. Accent de texte ponctuel."
    },
    "muted": {
      "$type": "color",
      "$value": "#5B6470",
      "$description": "Gris texte. Texte d'un élément désactivé (pagination)."
    },
    "bg-blue": {
      "$type": "color",
      "$value": "#E3F0FC",
      "$description": "Bleu pastel. Fonds de section, pied de page, en-têtes de tableau, survol des sous-menus."
    },
    "bg-blue-mid": {
      "$type": "color",
      "$value": "#CFE5FA",
      "$description": "Bleu moyen. Entrée de menu ouverte ou active, bouton doux, badge « Interne », zone photo."
    },
    "bg-sky": {
      "$type": "color",
      "$value": "#A9D1F5",
      "$description": "Bleu ciel. Décor (cercles), survol du bouton doux."
    },
    "bg-coral": {
      "$type": "color",
      "$value": "#FFE6E5",
      "$description": "Rose. Bandeau « Agir avec nous », rubrique Nos Actions."
    },
    "bg-mint": {
      "$type": "color",
      "$value": "#E2F3EE",
      "$description": "Menthe. Agenda, encadré « À retenir », bloc « Une question ? »."
    },
    "bg-peach": {
      "$type": "color",
      "$value": "#FFEBDD",
      "$description": "Pêche. Newsletter, rubrique Nos Actualités."
    },
    "page": {
      "$type": "color",
      "$value": "#FAF8F7",
      "$description": "Fond de page. Fond général du site."
    },
    "card": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Blanc. Cartes, en-tête, panneaux de menu, champs."
    },
    "border-field": {
      "$type": "color",
      "$value": "#767676",
      "$description": "Bordure de champ. Bordure 2 px des champs, séparateurs du menu (3:1 minimum)."
    },
    "border-table": {
      "$type": "color",
      "$value": "#B8C0CA",
      "$description": "Bordure de tableau. Cellules de tableau, pagination désactivée. Jamais pour un composant interactif."
    },
    "border-soft": {
      "$type": "color",
      "$value": "#D9DEE5",
      "$description": "Filet. Filets de l'en-tête autour du menu. Décoratif."
    },
    "border-list": {
      "$type": "color",
      "$value": "#E6E9ED",
      "$description": "Filet de liste. Séparation des liens d'un sous-menu. Décoratif."
    },
    "deco-pink": {
      "$type": "color",
      "$value": "#FFB3B2",
      "$description": "Rose décor. Pastilles décoratives (aria-hidden). Jamais sous du texte."
    },
    "deco-coral": {
      "$type": "color",
      "$value": "#FF4948",
      "$description": "Corail charte. Couleur d'origine de la charte : décor uniquement, jamais sous un texte blanc (3,3:1)."
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": [
        "Atkinson Hyperlegible",
        "system-ui",
        "sans-serif"
      ],
      "$description": "Police du texte. Charte : Luciole pour les titres."
    },
    "size": {
      "display": {
        "$type": "dimension",
        "$value": "52px",
        "$description": "Titre h1 de l'accueil (.hero-title)."
      },
      "h1": {
        "$type": "dimension",
        "$value": "48px",
        "$description": "Titre h1 des autres pages (.page-title, bandeau de titre)."
      },
      "h2-section": {
        "$type": "dimension",
        "$value": "36px",
        "$description": "Titre h2 d'une section pleine largeur (Agenda, Nos actualités, À lire aussi…). La maquette va de 32 à 40 px : s'aligner sur 36 px."
      },
      "h2-content": {
        "$type": "dimension",
        "$value": "32px",
        "$description": "Titre h2 dans un texte de lecture (.prose h2), « Dans la même rubrique », « Une question ? »."
      },
      "h3": {
        "$type": "dimension",
        "$value": "26px",
        "$description": "Titre h3 de carte « engagement ». Dans .prose : 23 px."
      },
      "h4": {
        "$type": "dimension",
        "$value": "22px",
        "$description": "Titre de carte, question de FAQ, « À retenir », titre de sommaire."
      },
      "lead": {
        "$type": "dimension",
        "$value": "21px",
        "$description": "Chapeau sous le h1 du bandeau de titre."
      },
      "article": {
        "$type": "dimension",
        "$value": "20px",
        "$description": "Texte de lecture longue (.prose) et chapeaux de section."
      },
      "body": {
        "$type": "dimension",
        "$value": "18px",
        "$description": "Texte courant, menu, boutons. Minimum pour un paragraphe."
      },
      "meta": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Dates, badges, mentions sous un formulaire. Minimum absolu, jamais un paragraphe de contenu."
      }
    },
    "size-mobile": {
      "display": {
        "$type": "dimension",
        "$value": "38px"
      },
      "h1": {
        "$type": "dimension",
        "$value": "34px"
      },
      "h2-section": {
        "$type": "dimension",
        "$value": "28px"
      },
      "h2-content": {
        "$type": "dimension",
        "$value": "28px"
      },
      "h3": {
        "$type": "dimension",
        "$value": "23px"
      },
      "h4": {
        "$type": "dimension",
        "$value": "22px"
      },
      "lead": {
        "$type": "dimension",
        "$value": "19px"
      },
      "article": {
        "$type": "dimension",
        "$value": "19px"
      },
      "body": {
        "$type": "dimension",
        "$value": "18px"
      },
      "meta": {
        "$type": "dimension",
        "$value": "16px"
      }
    },
    "line-height": {
      "display": {
        "$type": "number",
        "$value": 1.12
      },
      "h1": {
        "$type": "number",
        "$value": 1.12
      },
      "h2-section": {
        "$type": "number",
        "$value": 1.2
      },
      "h2-content": {
        "$type": "number",
        "$value": 1.25
      },
      "h3": {
        "$type": "number",
        "$value": 1.3
      },
      "h4": {
        "$type": "number",
        "$value": 1.3
      },
      "lead": {
        "$type": "number",
        "$value": 1.5
      },
      "article": {
        "$type": "number",
        "$value": 1.7
      },
      "body": {
        "$type": "number",
        "$value": 1.6
      },
      "meta": {
        "$type": "number",
        "$value": 1.5
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
